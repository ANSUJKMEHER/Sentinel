{
  "name": "Sentinel Security Bot",
  "url": "https://github.com/ANSUJKMEHER/Sentinel",
  "description": "Org-wide automated dependency vulnerability mitigation and pull request orchestration for GitHub.",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "vulnerability_alerts": "read",
    "metadata": "read"
  },
  "default_events": [
    "repository_vulnerability_alert",
    "pull_request",
    "push"
  ]
}
